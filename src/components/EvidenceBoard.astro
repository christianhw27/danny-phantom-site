---
import Polaroid from './Polaroid.astro';

interface Image {
    src: string;
    alt: string;
    caption?: string;
    description?: string;
}

interface Props {
    images: Image[];
}

const { images } = Astro.props;

// Pola rotasi dan margin acak untuk efek "berantakan"
const patterns = [
    { rotate: 'rotate-2', margin: 'md:mt-4 z-10' },
    { rotate: '-rotate-3', margin: 'md:-mt-10 md:ml-8 z-30' },
    { rotate: 'rotate-3', margin: 'md:mt-12 md:-ml-4 z-10' },
    { rotate: '-rotate-2', margin: 'md:-mt-6 md:ml-12 z-40' },
    { rotate: 'rotate-2', margin: 'md:mt-8 md:ml-4 z-20' },
    { rotate: '-rotate-3', margin: 'md:-mt-16 z-10' }
];
---

<section class="relative w-full pt-2 pb-10 md:pt-4 md:pb-16">
    
    <svg class="absolute inset-0 w-full h-full z-0 opacity-40 pointer-events-none" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <pattern id="red-threads" x="0" y="0" width="300" height="300" patternUnits="userSpaceOnUse">
                <path d="M0 50 L300 250 M100 0 L50 300 M250 0 L0 150" stroke="#E60012" stroke-width="1" stroke-dasharray="5,5" fill="none"/>
            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#red-threads)"/>
    </svg>
    
    <div class="relative z-10 max-w-6xl mx-auto text-center mb-10 md:mb-14 px-4">
        <div class="inline-flex flex-wrap justify-center items-center relative transform -rotate-1 mt-4 md:mt-8">
            <div class="absolute -top-8 -left-8 md:-top-10 md:-left-12 text-5xl md:text-6xl text-[#E60012] opacity-50 rotate-12 select-none font-black">?</div>
            
            <h2 class="flex flex-wrap justify-center gap-1 md:gap-3">
                <span class="inline-block bg-[#E60012] text-white px-3 md:px-5 py-1 md:py-2 text-3xl md:text-5xl font-black uppercase tracking-widest transform skew-x-6 border-2 border-white shadow-[3px_3px_0_#000] md:shadow-[5px_5px_0_#000]">
                    EVIDENCE
                </span>
                <span class="inline-block bg-white text-black px-3 md:px-5 py-1 md:py-2 text-3xl md:text-5xl font-black uppercase tracking-widest transform -skew-x-6 border-2 border-black shadow-[3px_3px_0_#E60012] md:shadow-[5px_5px_0_#E60012] mt-1 md:mt-0">
                    BOARD
                </span>
            </h2>

            <div class="absolute -bottom-6 -right-8 md:-bottom-8 md:-right-12 text-5xl md:text-6xl text-[#E60012] opacity-50 -rotate-12 select-none font-black">!</div>
        </div>
    </div>

    <div class="relative z-10 grid grid-cols-2 md:flex md:flex-wrap md:justify-center md:items-start gap-2 md:gap-y-12 md:gap-x-6 mt-8 px-2 md:px-10 pb-10">
        {images.map((img, index) => {
            const p = patterns[index % patterns.length];
            
            return (
                <div class="flex justify-center w-full md:w-auto md:block">
                    <Polaroid 
                        src={img.src} 
                        alt={img.alt} 
                        caption={img.caption || ""} 
                        description={img.description || ""}
                        rotate={p.rotate}
                        customClass={p.margin}
                    />
                </div>
            )
        })}
    </div>
</section>