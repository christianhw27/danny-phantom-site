---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/^\/|\/$/g, '');
---

<header class="sticky top-0 z-50 bg-black border-b-4 border-[#E60012] shadow-[0px_10px_20px_rgba(0,0,0,0.5)] font-sans">
    
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-3 flex justify-between items-center">
        
        <a href="/" class="group relative inline-block transform -skew-x-12 hover:scale-105 transition duration-300 z-50">
            <div class="absolute inset-0 bg-white transform translate-x-1 translate-y-1 group-hover:bg-[#E60012] transition"></div>
            <div class="relative bg-black text-white px-4 py-1 border-2 border-white">
                <span class="font-black italic text-xl md:text-2xl tracking-tighter">
                    DANNY<span class="text-[#E60012] group-hover:text-white transition">CHRISTIAN</span>
                </span>
            </div>
        </a>

        <nav class="hidden md:flex items-center gap-6 font-black italic text-lg uppercase tracking-wider">
            <a href="/about" class={`px-4 py-1 transform -skew-x-12 border-2 transition-all duration-300
                ${currentPath === 'about' ? 'bg-[#E60012] text-white border-black shadow-[2px_2px_0px_#fff]' : 'text-white border-transparent hover:bg-white hover:text-black hover:border-white'}`}>
                <span class="block transform skew-x-12">About</span>
            </a>
            <a href="/blog" class={`px-4 py-1 transform -skew-x-12 border-2 transition-all duration-300
                ${currentPath.startsWith('blog') ? 'bg-[#E60012] text-white border-black shadow-[2px_2px_0px_#fff]' : 'text-white border-transparent hover:bg-white hover:text-black hover:border-white'}`}>
                <span class="block transform skew-x-12">Mission Logs</span>
            </a>
            <a href="/contact" class={`group px-4 py-1 transform -skew-x-12 border-2 transition-all duration-300
                ${currentPath === 'contact' ? 'bg-[#E60012] text-white border-black shadow-[2px_2px_0px_#fff]' : 'text-white border-transparent hover:bg-white hover:text-black hover:border-white'}`}>
                <span class="block transform skew-x-12 flex items-center gap-2">
                    <class="hidden group-hover:inline-block transition">
                    Calling Card
                </span>
            </a>
        </nav>

        <button id="mobile-menu-btn" class="md:hidden text-white focus:outline-none z-50 relative group">
            <div class="space-y-2">
                <span class="block w-8 h-1 bg-white transform group-hover:rotate-3 transition duration-300"></span>
                <span class="block w-8 h-1 bg-[#E60012] transform group-hover:-rotate-3 transition duration-300"></span>
                <span class="block w-8 h-1 bg-white transform group-hover:rotate-3 transition duration-300"></span>
            </div>
        </button>

    </div>

    <div id="mobile-drawer" class="fixed inset-0 z-40 transform translate-x-full transition-transform duration-300 ease-in-out md:hidden">
        
        <div id="drawer-overlay" class="absolute inset-0 bg-black bg-opacity-90 backdrop-blur-sm"></div>
        
        <div class="absolute right-0 top-0 bottom-0 w-3/4 bg-[#E60012] p-8 shadow-[-10px_0px_20px_rgba(0,0,0,0.8)] flex flex-col justify-center border-l-8 border-black">
            
            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 10px 10px;"></div>

            <nav class="relative z-10 flex flex-col gap-6 font-black italic text-3xl text-right">
                
                <a href="/" class="text-black hover:text-white transition transform hover:-translate-x-2">HOME</a>
                <a href="/about" class="text-black hover:text-white transition transform hover:-translate-x-2">ABOUT</a>
                <a href="/blog" class="text-black hover:text-white transition transform hover:-translate-x-2">MISSION LOGS</a>
                <a href="/contact" class="text-white border-4 border-black px-4 py-2 bg-black hover:bg-white hover:text-black transition shadow-[5px_5px_0px_0px_#000]">
                    CALLING CARD
                </a>

            </nav>

            <img 
                src="/image/p5-take-your-time.png" 
                alt="TAKE YOUR TIME" 
                class="absolute bottom-8 right-6 w-32 md:w-40 opacity-100 filter "
            />
        </div>
    </div>

    <div class="absolute bottom-0 left-0 h-[1px] bg-white w-full opacity-20"></div>
</header>

<script>
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('drawer-overlay');

    // Fungsi Toggle (Buka/Tutup)
    function toggleMenu() {
        const isClosed = drawer.classList.contains('translate-x-full');
        if (isClosed) {
            drawer.classList.remove('translate-x-full'); // Buka (Geser Masuk)
        } else {
            drawer.classList.add('translate-x-full'); // Tutup (Geser Keluar)
        }
    }

    // Event Listeners
    btn.addEventListener('click', toggleMenu);
    overlay.addEventListener('click', toggleMenu); // Klik area gelap buat nutup juga
</script>