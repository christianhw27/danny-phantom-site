---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro'; // <--- IMPORT INI PENTING

const { title } = Astro.props;
---

<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/icon.png" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Teko:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-[#e6e6e6] font-sans flex flex-col min-h-screen relative overflow-x-hidden w-full max-w-[100vw]">

    <Navbar /> 
    
    <main class="flex-grow w-full max-w-[100vw] overflow-x-hidden relative">
        <slot />
    </main>

    <footer class="bg-black text-white relative mt-20 pt-16 pb-8 z-40 border-t-4 border-[#E60012]" style="clip-path: polygon(0 20%, 100% 0, 100% 100%, 0% 100%);">
        
        <div class="absolute top-0 left-0 w-full h-2 bg-[#E60012]"></div>

        <div class="max-w-6xl mx-auto px-6 text-center">
            <div class="mb-6 flex justify-center">
                 <img src="/image/p5-logo-small.png" class="w-12 h-12 object-contain opacity-50 hover:opacity-100 transition" alt="Phantom Thieves" />
            </div>

            <p class="font-bold italic tracking-wider text-gray-500">
                &copy; 2026 Danny Christian. <span class="text-[#E60012]">Take Your Time.</span>
            </p>
        </div>
    </footer>

</body>
</html>