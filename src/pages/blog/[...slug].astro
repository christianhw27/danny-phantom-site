---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
	const blogEntries = await getCollection('blog');
	return blogEntries.map(entry => ({
		params: { slug: entry.slug }, props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<MainLayout title={entry.data.title}>
	
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
    </div>

    <article class="relative z-10 max-w-4xl mx-auto px-4 md:px-6 py-10 md:py-16">

        <a href="/blog" class="inline-block mb-6 md:mb-8 group">
            <div class="bg-black text-white px-4 md:px-6 py-2 font-black italic transform -skew-x-12 border-2 border-transparent group-hover:bg-[#E60012] group-hover:border-black transition shadow-[4px_4px_0px_0px_#888] text-sm md:text-base">
                <span class="block transform skew-x-12">❮ BACK TO ARCHIVES</span>
            </div>
        </a>

        <div class="relative bg-white border-4 border-black p-5 md:p-12 shadow-[8px_8px_0px_0px_#000] md:shadow-[12px_12px_0px_0px_#000] transform md:-rotate-1">
            
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-24 md:w-32 h-6 md:h-8 bg-[#E60012] opacity-80 transform -rotate-2 shadow-sm"></div>

            <header class="mb-8 md:mb-10 text-center border-b-4 border-black pb-6 md:pb-8 border-dashed">
                
                <div class="flex flex-col md:flex-row justify-center items-center gap-2 md:gap-4 mb-4 text-xs md:text-sm font-bold uppercase tracking-widest text-gray-500">
                    <span class="bg-gray-200 px-2 py-1 transform -skew-x-12">
                        {entry.data.category || "UNCATEGORIZED"}
                    </span>
                    <span class="hidden md:inline text-[#E60012]">●</span>
                    <span>
                        {entry.data.pubDate.toLocaleDateString('id-ID', { dateStyle: 'long' })}
                    </span>
                </div>

                <h1 class="text-3xl md:text-6xl font-black italic leading-tight text-black mb-6 uppercase break-words">
                    {entry.data.title}
                </h1>

                {entry.data.image && (
                    <div class="relative inline-block transform md:rotate-1 p-1 md:p-2 bg-white border-2 border-gray-300 shadow-lg mt-2 md:mt-4 max-w-full">
                        <img 
                            src={entry.data.image} 
                            alt={entry.data.title} 
                            class="w-full h-auto max-h-[300px] md:max-h-[500px] object-cover filter contrast-110 border border-black" 
                        />
                        
                        <img 
                            src="/image/dagger.png" 
                            alt="" 
                            class="hidden md:block absolute -top-8 -right-8 w-20 h-auto transform drop-shadow-lg z-20 pointer-events-none" 
                        />
                    </div>
                )}
            </header>

            <div 
                class="prose prose-base md:prose-lg max-w-none font-optima text-justify
                       prose-headings:font-optima prose-headings:font-black prose-headings:italic 
                       prose-p:font-optima prose-li:font-optima prose-strong:font-optima
                       prose-a:text-[#E60012] prose-img:border-2 prose-img:border-black prose-img:shadow-[4px_4px_0px_0px_#000]"
                style="font-family: 'Optima', sans-serif;"
            >
                <Content />
            </div>

            <div class="mt-10 md:mt-16 pt-6 md:pt-8 border-t-4 border-black flex justify-between items-center">
                <span class="font-bold italic text-gray-400 text-sm md:text-base">END OF FILE.</span>
                <img src="/image/p5-logo-small.png" class="w-8 md:w-12 opacity-50" alt="" />
            </div>

        </div>

    </article>

</MainLayout>