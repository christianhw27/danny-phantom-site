---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Send Calling Card">

    <div class="relative z-10 min-h-screen flex flex-col items-center justify-center px-2 py-10 md:py-20 overflow-hidden">

        <img 
            src="/image/dagger.png" 
            class="hidden md:block absolute top-0 right-[10%] w-40 z-30 drop-shadow-2xl transform "
            alt=""
        />

        <div 
            class="relative w-full max-w-6xl bg-[#E60012] md:bg-transparent shadow-[10px_10px_0px_0px_#000] md:shadow-[20px_20px_0px_0px_#000] transform md:-rotate-1 p-4 md:p-16 rounded-xl border-4 border-black"
            style="background-image: var(--bg-image); background-size: 100% 100%;"
        >
            <style>
                div { --bg-image: none; }
                @media (min-width: 768px) {
                    div { --bg-image: url('/image/p5-calling-card-bg.png'); }
                }
            </style>
            
            <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 md:gap-12 relative z-10 items-center">

                <div class="lg:col-span-2 text-white flex flex-col justify-center space-y-4 md:space-y-6 text-center lg:text-left">
                    
                    <h1 class="text-4xl md:text-6xl font-black italic tracking-tighter leading-none flex flex-col items-center lg:items-start filter drop-shadow-lg">
                        <span class="bg-black text-white px-4 py-1 transform -skew-x-12 border-2 border-white inline-block shadow-[4px_4px_0px_0px_#E60012]">
                            TAKE
                        </span>
                        <span class="bg-white text-black px-4 py-1 transform skew-x-12 border-2 border-black inline-block mt-2 shadow-[4px_4px_0px_0px_#000]">
                            MY HEART!
                        </span>
                    </h1>
                    
                    <div class="relative font-bold font-sans text-sm md:text-xl bg-black md:bg-[#E60012] text-white p-4 md:p-6 transform md:-skew-x-3 border-4 border-white md:border-black shadow-lg">
                        <p class="md:transform md:skew-x-3 leading-relaxed">
                            "Sir Danny. We will steal your precious time to discuss a new mission!"
                        </p>
                    </div>

                    <div class="flex flex-wrap gap-2 justify-center lg:justify-start font-black italic text-xs md:text-sm">
                        <a href="https://github.com/christianhw27" class="bg-black border-2 border-white px-3 py-2 hover:bg-white hover:text-black transition">GITHUB</a>
                        <a href="https://www.instagram.com/dannyy.chr/" class="bg-black border-2 border-white px-3 py-2 hover:bg-white hover:text-black transition">INSTAGRAM</a>
                    </div>
                </div>


                <div class="lg:col-span-3 bg-white p-4 md:p-10 border-4 border-black transform md:rotate-1 shadow-[8px_8px_0px_0px_#000] md:shadow-[12px_12px_0px_0px_#000] relative w-full">
                    
                    <h2 class="text-2xl md:text-3xl font-black italic text-black mb-4 md:mb-8 flex items-center gap-2">
                        <span class="text-[#E60012]">►</span> SEND REQUEST
                    </h2>

                    <form action="mailto:dannyychr27@gmail.com" method="POST" enctype="text/plain" class="space-y-4 md:space-y-5 font-sans">
                        
                        <div class="relative group">
                            <label class="block font-black italic bg-black text-white px-2 py-1 w-fit mb-1 transform -skew-x-12 text-xs md:text-sm">CODENAME</label>
                            <input type="text" name="codename" class="w-full bg-gray-100 border-2 md:border-4 border-black p-2 md:p-3 font-bold focus:bg-black focus:text-white outline-none" placeholder="JOKER" required />
                        </div>

                        <div class="relative group">
                            <label class="block font-black italic bg-black text-white px-2 py-1 w-fit mb-1 transform -skew-x-12 text-xs md:text-sm">CHANNEL</label>
                            <input type="email" name="email" class="w-full bg-gray-100 border-2 md:border-4 border-black p-2 md:p-3 font-bold focus:bg-black focus:text-white outline-none" placeholder="email@phantom.com" required />
                        </div>

                        <div class="relative group">
                            <label class="block font-black italic bg-black text-white px-2 py-1 w-fit mb-1 transform -skew-x-12 text-xs md:text-sm">MISSION</label>
                            <textarea name="message" rows="3" class="w-full bg-gray-100 border-2 md:border-4 border-black p-2 md:p-3 font-bold focus:bg-black focus:text-white outline-none resize-none" placeholder="We have a target..." required></textarea>
                        </div>

                        <button type="submit" class="w-full group relative mt-6 cursor-pointer">
                            <div class="absolute inset-0 bg-black transform translate-x-1 translate-y-1 md:translate-x-2 md:translate-y-2 group-hover:translate-x-3 group-hover:translate-y-3 transition"></div>
                            <div class="relative bg-[#E60012] border-2 md:border-4 border-black p-3 md:p-4 flex justify-center items-center gap-2 md:gap-4 group-hover:bg-white transition-colors">
                                <span class="font-black italic text-lg md:text-2xl text-white group-hover:text-black tracking-widest">SEND CARD</span>
                            </div>
                        </button>

                    </form>
                </div>

            </div>
        </div>

    </div>
</MainLayout>